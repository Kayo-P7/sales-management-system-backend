# servidor web
# porta onde a aplicacao executa
SERVER_PORT=8089

# conexao jdbc com o banco de dados postgresql
DB_URL=jdbc:postgresql://localhost:5432/sales_management

# usuario que a aplicacao usa para autenticar no postgresql
DB_USERNAME=postgres

# senha que a aplicacao usa para autenticar no postgresql
DB_PASSWORD=postgres

# seguranca e autenticacao jwt
# segredo criptografico para geracao e validacao dos tokens jwt (minimo 256 bits)
JWT_SECRET=sua_chave_secreta_aqui

# controle de taxa de requisicoes (rate limit com bucket4j)
# habilita ou desativa o rate limiting globalmente
RATE_LIMIT_ENABLED=true

# limite de requisicoes no intervalo para rotas de autenticacao (/api/v1/auth/**)
RATE_LIMIT_AUTH_CAPACITY=10

# quantidade de tokens repostos por ciclo em autenticacao
RATE_LIMIT_AUTH_REFILL_TOKENS=10

# duracao do ciclo de reposicao de autenticacao em segundos
RATE_LIMIT_AUTH_DURATION=60

# limite de requisicoes no intervalo para rotas gerais (/api/v1/**)
RATE_LIMIT_GENERAL_CAPACITY=60

# quantidade de tokens repostos por ciclo para rotas gerais
RATE_LIMIT_GENERAL_REFILL_TOKENS=60

# duracao do ciclo de reposicao geral em segundos
RATE_LIMIT_GENERAL_DURATION=60

# migracao e versionamento de banco (flyway)
# ativa a execucao automatica das migracoes no boot da aplicacao
FLYWAY_ENABLED=true

# permite criar linha de base para bancos existentes sem falhas de migracao
FLYWAY_BASELINE_ON_MIGRATE=true

# versao inicial considerada na linha de base
FLYWAY_BASELINE_VERSION=1

# origens permitidas no cors (separadas por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200
