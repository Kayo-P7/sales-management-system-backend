# porta da aplicacao
SERVER_PORT=8089

# configuracao do banco de dados postgresql
POSTGRES_DB=sales_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5439

# conexao jdbc com o banco de dados (para desenvolvimento local fora do docker use localhost:5439)
DB_URL=jdbc:postgresql://database:5432/sales_management
DB_USERNAME=postgres
DB_PASSWORD=postgres

# segredo para geracao e validacao dos tokens jwt (minimo 256 bits em base64/hex)
JWT_SECRET=sua_chave_secreta

# configuracoes de rate limit (valores padrao, pode alterarr)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_TOKENS=10
RATE_LIMIT_AUTH_DURATION=60
RATE_LIMIT_GENERAL_CAPACITY=60
RATE_LIMIT_GENERAL_REFILL_TOKENS=60
RATE_LIMIT_GENERAL_DURATION=60

